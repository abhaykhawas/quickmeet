# Meeting API
PORT=8787
PUBLIC_API_URL=http://localhost:8787
PUBLIC_APP_URL=http://localhost:5173
QUICKMEET_API_KEY=change-this-for-production
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173

# MongoDB meeting storage
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quickmeet?retryWrites=true&w=majority
MONGO_COLLECTION=quickmeet_meetings

# LiveKit media server
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Demo app
VITE_QUICKMEET_API_URL=http://localhost:8787
