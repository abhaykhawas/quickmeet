{
  "name": "@quickmeet/sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic QuickMeet browser SDK",
  "license": "Apache-2.0",
  "keywords": [
    "quickmeet",
    "video-conferencing",
    "webrtc",
    "livekit",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
